# PostgreSQL connection string. Keep real credentials in your hosting provider's secret store.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Add provider credentials only when the corresponding integration is implemented.

# Admin session signing secret (generate a random value with at least 32 bytes).
AUTH_SECRET="replace-with-a-random-secret-at-least-32-bytes-long"

# Used only when running npm run admin:create; do not commit real values.
ADMIN_NAME="Site Owner"
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="use-a-unique-password-of-at-least-12-characters"
