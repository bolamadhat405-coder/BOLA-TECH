generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InquiryStatus {
  NEW
  REVIEWING
  WAITING_FOR_CUSTOMER
  APPROVED
  IN_PROGRESS
  READY_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum AuditActorType {
  SYSTEM
  ADMIN
  CUSTOMER
}

model Inquiry {
  id            String        @id @default(cuid())
  reference     String        @unique
  customerName  String
  email         String
  phone         String?
  company       String?
  message       String        @db.Text
  items         Json
  status        InquiryStatus @default(NEW)
  source        String        @default("website")
  consentAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  events        InquiryEvent[]

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model InquiryEvent {
  id         String          @id @default(cuid())
  inquiryId  String
  actorType  AuditActorType   @default(SYSTEM)
  actorLabel String          @default("System")
  action     String
  details    Json?
  createdAt  DateTime        @default(now())
  inquiry    Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
}

model AdminUser {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            String   @default("ADMIN")
  isActive        Boolean  @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DigitalProduct {
  id             String   @id @default(cuid())
  slug           String   @unique
  nameAr         String
  nameEn         String
  descriptionAr  String   @db.Text
  descriptionEn  String   @db.Text
  category       String
  deliveryType   String
  priceMinor     Int?
  currency       String   @default("EGP")
  isPublished    Boolean  @default(false)
  requiresReview Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, category])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AuditLog {
  id          String         @id @default(cuid())
  actorType   AuditActorType
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipHash      String?
  createdAt   DateTime       @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

enum WorkspaceArea {
  CRM
  PROJECTS
  FINANCE
  INVENTORY
  HR
  SALES
  SUPPORT
}

model WorkspaceRecord {
  id          String        @id @default(cuid())
  area        WorkspaceArea
  title       String
  description String?       @db.Text
  status      String        @default("OPEN")
  reference   String?       @unique
  customer    String?
  owner       String?
  amountMinor Int?
  currency    String        @default("EGP")
  dueAt       DateTime?
  data        Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([area, status, updatedAt])
  @@index([customer])
  @@index([dueAt])
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}
enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}
enum StockMovementType {
  IN
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?  @unique
  passwordHash String?
  phone       String?
  company     String?
  address     String?  @db.Text
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
  projects    Project[]
  tickets     SupportTicket[]
  invoices    Invoice[]
  contracts   Contract[]
  @@index([name])
  @@index([phone])
}

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  slug           String   @unique
  nameAr         String
  nameEn         String
  descriptionAr  String   @default("") @db.Text
  descriptionEn  String   @default("") @db.Text
  category       String
  kind           String   @default("PHYSICAL")
  priceMinor     Int
  costMinor      Int      @default(0)
  currency       String   @default("EGP")
  stockQuantity  Int      @default(0)
  lowStockAt     Int      @default(3)
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  warehouseStocks WarehouseStock[]
  purchaseOrderItems PurchaseOrderItem[]
  @@index([category, isPublished])
  @@index([nameAr, nameEn])
}

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique
  customerId  String
  status      OrderStatus @default(PENDING)
  subtotal    Int
  discount    Int          @default(0)
  total       Int
  currency    String       @default("EGP")
  notes       String?      @db.Text
  paymentMethod String     @default("COD")
  paymentStatus String     @default("UNPAID")
  shippingAddress String? @db.Text
  shippingCarrier String?
  trackingNumber String?
  trackingUrl String?
  shippedAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  customer    Customer     @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  invoice     Invoice?
  couponCode String?
  couponRedemption CouponRedemption?
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String?
  title         String
  quantity      Int
  unitPrice     Int
  lineTotal     Int
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
  @@index([productId])
}

model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNED)
  budget      Int?
  currency    String        @default("EGP")
  startAt     DateTime?
  dueAt       DateTime?
  customerId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tasks       ProjectTask[]
  @@index([status, dueAt])
  @@index([customerId])
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?  @db.Text
  status      String   @default("TODO")
  priority    String   @default("MEDIUM")
  assignee    String?
  dueAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, status])
  @@index([assignee, dueAt])
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  customerId  String
  orderId     String?       @unique
  status      InvoiceStatus @default(DRAFT)
  subtotal    Int
  tax         Int           @default(0)
  total       Int
  paid        Int           @default(0)
  currency    String        @default("EGP")
  issuedAt    DateTime?
  dueAt       DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  customer    Customer      @relation(fields: [customerId], references: [id])
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  @@index([customerId, createdAt])
  @@index([status, dueAt])
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String
  amount      Int
  currency    String   @default("EGP")
  vendor      String?
  reference   String?
  notes       String?  @db.Text
  incurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  @@index([category, incurredAt])
}

model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contactName String?
  email       String?
  phone       String?
  taxNumber   String?
  address     String?  @db.Text
  currency    String   @default("EGP")
  paymentTerms String?
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
  @@index([name])
  @@index([isActive])
}

model Warehouse {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  address     String?  @db.Text
  managerName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  stocks      WarehouseStock[]
  purchaseOrders PurchaseOrder[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo StockTransfer[] @relation("TransferTo")
  @@index([isActive])
}

model WarehouseStock {
  id          String   @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([warehouseId, productId])
  @@index([productId])
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  number      String   @unique
  supplierId  String
  warehouseId String
  status      String   @default("DRAFT")
  currency    String   @default("EGP")
  subtotal    Int      @default(0)
  notes       String?  @db.Text
  orderedAt   DateTime?
  expectedAt  DateTime?
  receivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  items       PurchaseOrderItem[]
  @@index([supplierId, createdAt])
  @@index([warehouseId, status])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantityOrdered Int
  quantityReceived Int @default(0)
  unitCost        Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])
  @@index([purchaseOrderId])
  @@index([productId])
}

model StockTransfer {
  id             String @id @default(cuid())
  reference      String @unique
  fromWarehouseId String
  toWarehouseId   String
  status         String @default("DRAFT")
  notes          String? @db.Text
  shippedAt      DateTime?
  receivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  fromWarehouse  Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse    Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items          StockTransferItem[]
  @@index([status, createdAt])
}

model StockTransferItem {
  id             String @id @default(cuid())
  transferId     String
  productId      String
  quantity       Int
  transfer       StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
  @@index([transferId])
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  type        StockMovementType
  quantity    Int
  unitCost    Int?
  reference   String?
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  product     Product           @relation(fields: [productId], references: [id])
  @@index([productId, createdAt])
}

model Employee {
  id          String   @id @default(cuid())
  employeeNo  String   @unique
  name        String
  email       String?  @unique
  phone       String?
  jobTitle    String
  department  String
  status      String   @default("ACTIVE")
  hiredAt     DateTime?
  salaryMinor Int?
  currency    String   @default("EGP")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([department, status])
}

model SupportTicket {
  id          String       @id @default(cuid())
  reference   String       @unique
  customerId  String
  subject     String
  description String       @db.Text
  status      TicketStatus @default(OPEN)
  priority    String       @default("NORMAL")
  assignedTo  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  customer    Customer     @relation(fields: [customerId], references: [id])
  @@index([status, priority, updatedAt])
  @@index([customerId, createdAt])
}

model Contract {
  id          String   @id @default(cuid())
  number      String   @unique
  title       String
  customerId  String
  status      String   @default("DRAFT")
  value       Int?
  currency    String   @default("EGP")
  startsAt    DateTime?
  endsAt      DateTime?
  terms       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])
  @@index([customerId, status])
}


enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  type            CouponType
  value           Int
  currency        String   @default("EGP")
  minSubtotal     Int      @default(0)
  maxDiscount     Int?
  usageLimit      Int?
  usageCount      Int      @default(0)
  perCustomerLimit Int     @default(1)
  startsAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  redemptions     CouponRedemption[]
  @@index([isActive, startsAt, expiresAt])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  orderId    String   @unique
  customerId String
  discount   Int
  createdAt  DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([couponId, customerId])
}
